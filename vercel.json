{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/cms?route=:match*"
    },
    {
      "source": "/api/admin",
      "destination": "/api/cms"
    },
    {
      "source": "/img-proxy/:path*",
      "destination": "/api/home?__imgproxy=1&__path=:path*"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/index.html",
      "destination": "/api/home"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/feed?type=rss"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed?type=rss"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/feed?type=sitemap"
    },
    {
      "source": "/(berkshire|indian|world|uk)/:slug",
      "destination": "/api/article?region=$1&slug=$2"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/article?slug=$1"
    },
    {
      "source": "/politics",
      "destination": "/politics.html"
    },
    {
      "source": "/tech",
      "destination": "/tech.html"
    },
    {
      "source": "/finance",
      "destination": "/finance.html"
    },
    {
      "source": "/entertainment",
      "destination": "/entertainment.html"
    },
    {
      "source": "/health",
      "destination": "/health.html"
    },
    {
      "source": "/manifesto",
      "destination": "/manifesto.html"
    },
    {
      "source": "/standards",
      "destination": "/standards.html"
    },
    {
      "source": "/funding",
      "destination": "/funding.html"
    },
    {
      "source": "/finances",
      "destination": "/finances.html"
    },
    {
      "source": "/collective",
      "destination": "/collective.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://*.vercel-scripts.com https://*.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://va.vercel-scripts.com https://*.vercel-scripts.com https://*.vercel-insights.com https://vitals.vercel-insights.com; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://va.vercel-scripts.com https://*.vercel-scripts.com https://*.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://va.vercel-scripts.com https://*.vercel-scripts.com https://*.vercel-insights.com https://vitals.vercel-insights.com; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "crons": []
}